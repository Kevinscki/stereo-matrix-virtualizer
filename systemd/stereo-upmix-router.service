[Unit]
Description=Enforce the selected stereo-upmix application route
After=pipewire.service wireplumber.service stereo-upmix-manager.service virtual-surround-manager.service
BindsTo=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/libexec/stereo-upmix-router
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
