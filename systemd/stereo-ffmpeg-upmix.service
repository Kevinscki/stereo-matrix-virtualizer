[Unit]
Description=Stereo Matrix Virtualizer FFmpeg surround active upmixer
After=pipewire.service wireplumber.service
BindsTo=pipewire.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/stereo-upmix-manager/ffmpeg-surround.env
ExecStart=%h/.local/libexec/stereo-active-engine ffmpeg
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
